APP_NAME=flashcards-api
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
CORS_ORIGINS=https://app.esli.app,https://esli.app
FRONTEND_URL=https://app.esli.app
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Paddle
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_CLIENT_TOKEN=test_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_PRO_MONTHLY_PRICE_ID=pri_01...
PADDLE_PRO_YEARLY_PRICE_ID=pri_01...
PADDLE_PREMIUM_MONTHLY_PRICE_ID=pri_01...
PADDLE_PREMIUM_YEARLY_PRICE_ID=pri_01...

# Transactional email (password reset). Get a key at resend.com and verify esli.app.
# Without it, reset links are only written to the server log.
RESEND_API_KEY=
EMAIL_FROM=Esli <noreply@esli.app>
